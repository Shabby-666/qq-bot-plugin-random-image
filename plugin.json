{"apiVersion":1,"id":"random-image","name":"随机图片","version":"1.0.0","entry":"plugin.mjs","description":"按分类获取随机图片，数据来自 uapis.cn 免费随机图片接口，支持二次元、风景、壁纸、表情包、福瑞等 17 个图片分类与全局随机。","permissions":["reply.text","reply.image"],"commands":[{"id":"random","triggers":["/随机图片","/随机图"],"mode":"prefix","description":"随机图片，可带分类名，如 /随机图片 二次元"},{"id":"acg","triggers":["/随机二次元图","/随机动漫图"],"mode":"exact","description":"随机二次元（动漫）图片"},{"id":"acg_pc","triggers":["/随机二次元电脑壁纸"],"mode":"exact","description":"随机二次元电脑壁纸"},{"id":"acg_mb","triggers":["/随机二次元手机壁纸"],"mode":"exact","description":"随机二次元手机壁纸"},{"id":"landscape","triggers":["/随机风景图","/随机风景"],"mode":"exact","description":"随机风景图片"},{"id":"anime","triggers":["/随机混合动漫图"],"mode":"exact","description":"随机混合动漫图片"},{"id":"pc_wallpaper","triggers":["/随机电脑壁纸","/随机壁纸"],"mode":"exact","description":"随机电脑壁纸"},{"id":"mobile_wallpaper","triggers":["/随机手机壁纸"],"mode":"exact","description":"随机手机壁纸"},{"id":"general_anime","triggers":["/随机综合动漫图"],"mode":"exact","description":"随机综合动漫图片"},{"id":"ai_drawing","triggers":["/随机AI绘画","/随机ai绘画"],"mode":"exact","description":"随机 AI 绘画图片"},{"id":"bq","triggers":["/随机表情包","/随机梗图"],"mode":"exact","description":"随机表情包与趣图"},{"id":"bq_maomao","triggers":["/随机猫猫图","/随机猫咪图"],"mode":"exact","description":"随机猫猫图片"},{"id":"bq_xiongmao","triggers":["/随机熊猫图"],"mode":"exact","description":"随机熊猫图片"},{"id":"bq_waiguoren","triggers":["/随机外国人"],"mode":"exact","description":"随机外国人表情包"},{"id":"bq_ikun","triggers":["/随机爱坤图","/随机坤图"],"mode":"exact","description":"随机爱坤（ikun）图片"},{"id":"bq_eciyuan","triggers":["/随机二次元表情包"],"mode":"exact","description":"随机二次元表情包"},{"id":"furry","triggers":["/随机福瑞图","/随机福瑞"],"mode":"exact","description":"随机福瑞（furry）图片"},{"id":"furry_4k","triggers":["/随机福瑞4K图","/随机4K图"],"mode":"exact","description":"随机福瑞 4K 图片"},{"id":"categories","triggers":["/图片分类","/图库分类"],"mode":"exact","description":"查看随机图片支持的全部分类"}]}
